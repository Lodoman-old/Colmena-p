{
  "name": "colmena-api",
  "version": "1.0.0",
  "description": "System Colmena API - Core backend for mobilización política PRI",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/",
    "docker:build": "docker build -t colmena-api .",
    "docker:dev": "docker-compose -f infrastructure/docker-compose.yml up --build"
  },
  "keywords": [
    "crm",
    "political-mobilization",
    "gis",
    "pri",
    "movilization"
  ],
  "author": "System Colmena Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.0",
    "redis": "^4.6.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.1",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.9",
    "@types/web-push": "^3.6.4",
    "eslint": "^8.48.0",
    "jest": "^29.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": "20.x",
    "npm": "9.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colmena-pri/system-colmena.git"
