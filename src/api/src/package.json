{
  "name": "colmena-api",
  "version": "1.0.0",
  "description": "System Colmena API - Core backend for mobilización política PRI",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/",
    "docker:build": "docker build -t colmena-api .",
    "docker:dev": "docker-compose -f infrastructure/docker-compose.yml up --build"
  },
  "keywords": ["crm", "political-mobilization", "gis", "pri", "movilization"],
  "author": "System Colmena Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.0",
    "dotenv": "^16.1.4",
    "express-rate-limit": "^6.7.0",
    "uuid": "^9.0.1",
    "socket.io": "^4.7.1",
    "redis": "^4.6.0",
    "ioredis": "^5.3.2",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "typescript": "^5.1.6",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.48.0",
    "@types/express": "^4.18.2",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colmena-pri/system-colmena.git"
  }
}